# TrustLens Backend — Environment Variables
# Copy this to .env and fill in your keys.

# Google Gemini API key (get free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here

# Gemini model to use (default: gemini-2.5-flash)
# Switch to gemini-3-flash-preview if gemini-2.5-flash is deprecated
GEMINI_MODEL=gemini-2.5-flash

# Exodus Privacy API token (optional — request at api@exodus-privacy.eu.org)
# If not set, tracker scanning will attempt unauthenticated requests
EXODUS_API_TOKEN=

# Note: HIBP and Mozilla Observatory require NO API keys
