{
  "manifest_version": 3,
  "name": "TrustLens",
  "version": "1.0.0",
  "description": "See the TrustLens privacy score for the website you are currently browsing.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://trustlens-qtex.onrender.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "TrustLens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://trusttlens.netlify.app/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}